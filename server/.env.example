# Copy to .env and replace local credentials. Never commit .env.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/toktickit?schema=public"
APP_ORIGIN="http://localhost:5173"
PORT=4000
NODE_ENV=development
# Legacy attachment import and fallback only. New uploads are stored in PostgreSQL.
UPLOAD_DIRECTORY=uploads
# Optional when creating demo accounts. Set privately, never commit real values.
# LAB3_INITIAL_PASSWORD=
# Set LAB3_INITIAL_PASSWORD only in your shell when first seeding (12-128 chars).
# Tests require a separate database named toktickit_lab4_test (see README.md and docs/lab-04/tests.md).
